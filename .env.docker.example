# ============================================================
# MemWyre Docker Compose — Environment Variables
# Copy this file to .env in the project root for docker-compose.
# ============================================================

# Database (required — no default)
DATABASE_URL=postgresql://user:password@host.docker.internal/brain-vault

# Redis / Celery (defaults to host.docker.internal:6379 if not set)
CELERY_BROKER_URL=redis://host.docker.internal:6379/0
REDIS_URL=redis://host.docker.internal:6379/0

# Frontend API URL (baked into the Vite build)
VITE_API_URL=http://localhost:8000/api/v1

# CORS origins (comma-separated, or "*" for dev)
CORS_ORIGINS=*
