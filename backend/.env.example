# ============================================================
# Memwyre Backend — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# --- Security ---
SECRET_KEY="change-me-to-a-random-64-char-string"

# --- Database ---
DATABASE_URL="postgresql://user:password@localhost/brain-vault"

# --- Redis / Celery ---
CELERY_BROKER_URL="redis://localhost:6379/0"
REDIS_URL="redis://localhost:6379/0"

# --- Vector DB (Pinecone) ---
PINECONE_API_KEY=""
PINECONE_HOST=""
PINECONE_SPARSE_HOST=""

# --- LLM API Keys ---
GEMINI_API_KEY=""
OPENAI_API_KEY=""
GOOGLE_API_KEY=""

# --- AWS (for S3 / other services) ---
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-south-1"

# --- OAuth ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# --- URLs ---
BACKEND_URL="http://localhost:8000"
FRONTEND_URL="http://localhost:5173"

# --- CORS (comma-separated origins, or "*" for dev) ---
CORS_ORIGINS="*"

# --- Dodo Payments ---
DODO_PAYMENTS_API_KEY=""
DODO_WEBHOOK_SECRET=""
DODO_PRODUCT_ID=""
DODO_ENVIRONMENT="test_mode"

# --- Feature Gating ---
DEV_MODE="true"
FREE_MEMORY_LIMIT="10"

# --- Admin ---
ADMIN_EMAILS="shivharehimansh@gmail.com"
