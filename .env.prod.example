# ============================================================
# Memwyre Production Environment Variables
# Copy to .env.prod on your EC2 instance and fill in values.
# ============================================================

# --- Database (RDS PostgreSQL) ---
DATABASE_URL=postgresql://user:password@your-rds-endpoint.amazonaws.com:5432/memwyre

# --- Security ---
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING
CORS_ORIGINS=https://memwyre.tech,https://www.memwyre.tech

# --- URLs ---
FRONTEND_URL=https://memwyre.tech
BACKEND_URL=https://api.memwyre.tech

# --- Pinecone Vector DB ---
PINECONE_API_KEY=
PINECONE_HOST=
# PINECONE_SPARSE_HOST=

# --- LLM API Keys ---
GOOGLE_API_KEY=
GEMINI_API_KEY=
# OPENAI_API_KEY=

# --- OAuth (Google) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- OAuth (GitHub) ---
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# --- Email (AWS SES) ---
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_SES_SENDER_EMAIL=noreply@memwyre.tech

# --- Admin ---
ADMIN_EMAILS=shivharehimansh@gmail.com

# --- LLM & Embedding Endpoints (DEFAULT: Kimi K2.6 + NVIDIA NIM) ---
# Both LLM and embeddings route through NVIDIA's API by default.
# Just provide your NVIDIA API key (from build.nvidia.com).
LLM_API_KEY=nvapi-your-nvidia-api-key
EMBEDDING_API_KEY=nvapi-your-nvidia-api-key
# LLM_API_BASE=https://integrate.api.nvidia.com/v1          (default)
# LLM_MODEL_NAME=moonshotai/kimi-k2.6                       (default)
# EMBEDDING_API_BASE=https://integrate.api.nvidia.com/v1     (default)
# EMBEDDING_MODEL_NAME=nvidia/nv-embedqa-e5-v5               (default)

# To switch BACK to Azure OpenAI or Bedrock, clear the base URLs:
# LLM_API_BASE=
# EMBEDDING_API_BASE=

# --- Rate Limiting (Requests Per Minute) ---
# EMBEDDING_RATE_LIMIT_RPM=60
# LLM_RATE_LIMIT_RPM=100

